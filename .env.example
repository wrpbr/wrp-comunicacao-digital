# Variáveis do `docker compose` deste POC.
#
# Na máquina da comissão este arquivo é opcional: sem `.env`, o compose sobe com os valores de
# demonstração escritos no `docker-compose.yml`.
# Para um endereço público, copie para `.env` (nunca vai para o git), troque todos os segredos
# do primeiro bloco e ajuste os endereços do segundo. O `.env` fica só no servidor.

# --- Segredos: troque todos antes de expor o sistema ---------------------------------------
# Chave que cifra as credenciais da WABA e os segredos TOTP (AES-256-GCM). Texto longo e aleatório.
SECRETS_KEY=
# Segredo do webhook: o Chatwoot assina com ele cada evento que manda para a API.
WEBHOOK_SECRET=
# Senha das contas de demonstração do painel e segredo TOTP (Base32) de admin e gestor.
DEMO_PASSWORD=
DEMO_TOTP_SECRET=
# Senha dos atendentes no Chatwoot: maiúscula, minúscula, número e símbolo. Sem ela, vale a DEMO_PASSWORD.
CHATWOOT_AGENT_PASSWORD=
# Senhas do PostgreSQL (usuário `wrp` e usuário `chatwoot`). Valem na criação do volume do banco.
POSTGRES_PASSWORD=
CHATWOOT_DB_PASSWORD=
# Chave do Rails do Chatwoot: 64 caracteres hexadecimais ou mais.
CHATWOOT_SECRET_KEY_BASE=

# --- Endereços -----------------------------------------------------------------------------
# Onde o Nginx e o Chatwoot escutam. 127.0.0.1 deixa as portas só para a própria máquina
# (ou para o proxy com TLS instalado nela).
WRP_BIND=127.0.0.1
WRP_HTTPS_PORT=8443
WRP_HTTP_PORT=8088
CHATWOOT_PORT=3309
# Origens do painel aceitas pela API (endereço público do painel), separadas por vírgula.
CORS_ORIGIN=https://127.0.0.1:8443,http://127.0.0.1:8088
# Endereço público do Chatwoot. Com https, ligue também CHATWOOT_FORCE_SSL.
CHATWOOT_FRONTEND_URL=http://127.0.0.1:3309
CHATWOOT_FORCE_SSL=false
# Token público da caixa de entrada do webchat (vai no endereço do widget).
CHATWOOT_WEBSITE_TOKEN=demoWebchatPompeu089
# Só quando outro proxy faz o TLS na frente deste Nginx: a faixa de rede dele. O Nginx passa a servir
# o sistema em HTTP na porta WRP_HTTP_PORT e a ler o endereço do visitante em X-Real-IP.
WRP_TRUSTED_PROXY=

# --- Modo demonstração ---------------------------------------------------------------------
DEMO_MODE=true
ALLOW_DEMO_MODE=true
# true mostra a senha e o código TOTP de demonstração na tela de login. Em endereço público: false.
DEMO_HINTS=true
# Cadastro aberto de contas no Chatwoot. Deixe false: as contas nascem pelo serviço chatwoot-bootstrap.
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=false

# --- WhatsApp Cloud API (Meta) -------------------------------------------------------------
# simulator não chama a Meta. live envia por https://graph.facebook.com com as credenciais abaixo
# (o administrador também pode gravar o token e o Phone Number ID por PUT /api/v1/settings/waba).
META_MODE=simulator
SIMULATOR_PATTERN=random
META_GRAPH_VERSION=v26.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Modelo aprovado na Meta para a mensagem que o órgão inicia fora da janela de 24 horas.
# META_TEMPLATE_BODY_PARAM=true envia o texto da mensagem como a variável {{1}} do corpo do modelo.
META_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=pt_BR
META_TEMPLATE_BODY_PARAM=true

# --- Franquia e alertas --------------------------------------------------------------------
FRANCHISE_MONTHLY=5000
FRANCHISE_PACK_SIZE=100
TECHNICAL_RESERVE=200
ADMIN_ALERT_PHONE=5537990000999
ALERT_EMAIL=gestor@pompeu.mg.gov.br
ALERT_WEBHOOK_URL=
BIRTHDAY_AUTORUN=true
# Quem envia o texto fixo de fora do expediente no WhatsApp: wrp (a API) ou chatwoot.
OOH_SENDER=wrp
